FROM ghcr.io/cirruslabs/android-sdk:36 AS build
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nodejs curl unzip ca-certificates coreutils && rm -rf /var/lib/apt/lists/*
COPY kafxclean-dist/build-selfcontained.sh /build-selfcontained.sh
RUN chmod +x /build-selfcontained.sh && /build-selfcontained.sh

FROM python:3.12-alpine
WORKDIR /srv
COPY --from=build /out/ /srv/
COPY kafxclean-dist/make-chunks.py /make-chunks.py
RUN python /make-chunks.py
CMD ["sh","-c","python -m http.server 8000 --bind 0.0.0.0 --directory /srv"]
